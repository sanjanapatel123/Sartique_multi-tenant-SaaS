generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  businessType           BusinessType            @default(FASHION)
  measurementDefinitions MeasurementDefinition[]
  measurementTemplates   MeasurementTemplate[]
  measurementProfiles    MeasurementProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  customers      Customer[]
  orders         Order[]
  features       OrganizationFeature[]
  employees      Employee[]
  productionJobs ProductionJob[]
  tasks          Task[]

  products             Product[]
  productCategories    ProductCategory[]
  attributeDefinitions AttributeDefinition[]

  inventoryItems InventoryItem[]
  warehouses     Warehouse[]
  stockMovements StockMovement[]
}

enum BusinessType {
  FASHION
  JEWELRY
  TAILORING
  ACCESSORIES
  OTHER
}

model ProductCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  isActive    Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Product {
  id String @id @default(cuid())

  name        String
  sku         String
  description String?

  price Decimal @db.Decimal(12, 2)

  isActive Boolean @default(true)

  categoryId String?

  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  attributes ProductAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
}

model AttributeDefinition {
  id String @id @default(cuid())

  name String
  key  String

  type AttributeType

  required Boolean @default(false)

  options Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  values ProductAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
  DATE
}

model ProductAttribute {
  id String @id @default(cuid())

  value Json

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributeDefinitionId String
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, attributeDefinitionId])
  @@index([productId])
  @@index([attributeDefinitionId])
}

model OrganizationFeature {
  id String @id @default(cuid())

  feature Feature
  enabled Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, feature])
  @@index([organizationId])
}

enum Feature {
  CUSTOMERS
  ORDERS
  INVENTORY
  PRODUCTS
  MEASUREMENTS
  PRODUCTION
  TASKS
  EMPLOYEES
  VENDORS
  PURCHASES
  POS
  PAYMENTS
  INVOICES
  REPORTS
}

model InventoryItem {
  id String @id @default(cuid())

  name        String
  sku         String
  category    String
  unit        String
  description String?

  lowStockThreshold Decimal @default(0) @db.Decimal(10, 2)
  isActive          Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stocks         InventoryStock[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([category])
}

model Warehouse {
  id String @id @default(cuid())

  name     String
  code     String
  address  String?
  isActive Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stocks         InventoryStock[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

model InventoryStock {
  id String @id @default(cuid())

  quantity Decimal @default(0) @db.Decimal(12, 3)
  reserved Decimal @default(0) @db.Decimal(12, 3)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inventoryItemId, warehouseId])
  @@index([warehouseId])
}

model StockMovement {
  id String @id @default(cuid())

  type     StockMovementType
  quantity Decimal           @db.Decimal(12, 3)

  referenceType String?
  referenceId   String?
  note          String?

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([createdAt])
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RESERVE
  RELEASE
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  role     Role

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  orders Order[] @relation("UserOrders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(cuid())

  name  String
  email String?
  phone String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  orders              Order[]
  measurementProfiles MeasurementProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phone])
  @@index([organizationId])
}

model Order {
  id String @id @default(cuid())

  orderNumber String
  title       String
  description String?

  totalAmount Decimal @db.Decimal(10, 2)

  status OrderStatus @default(PENDING)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  createdById String
  createdBy   User   @relation("UserOrders", fields: [createdById], references: [id])

  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  productionJobs ProductionJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderNumber, organizationId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

enum Role {
  ADMIN

  MANAGER

  TAILOR

  CUSTOMER
}

enum OrderStatus {
  PENDING
  APPROVED
  PRODUCTION
  QC
  COMPLETED
  DELIVERED
  CANCELLED
}

model MeasurementDefinition {
  id String @id @default(cuid())

  name String
  key  String

  unit MeasurementUnit @default(INCH)

  description String?

  isActive Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  templateFields MeasurementTemplateField[]
  values         MeasurementValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

enum MeasurementUnit {
  INCH
  CM
}

model MeasurementTemplate {
  id String @id @default(cuid())

  name        String
  description String?
  isActive    Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fields MeasurementTemplateField[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  measurementProfiles MeasurementProfile[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model MeasurementTemplateField {
  id String @id @default(cuid())

  required  Boolean @default(true)
  sortOrder Int     @default(0)

  templateId String
  template   MeasurementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  measurementDefinitionId String
  measurementDefinition   MeasurementDefinition @relation(fields: [measurementDefinitionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, measurementDefinitionId])
  @@index([templateId])
  @@index([measurementDefinitionId])
}

model MeasurementProfile {
  id String @id @default(cuid())

  name String

  isActive Boolean @default(true)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  templateId String
  template   MeasurementTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  versions MeasurementVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@index([templateId])
}

model MeasurementVersion {
  id String @id @default(cuid())

  version Int

  note String?

  profileId String
  profile   MeasurementProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  values MeasurementValue[]

  createdAt DateTime @default(now())

  @@unique([profileId, version])
  @@index([profileId])
  @@index([createdAt])
}

model MeasurementValue {
  id String @id @default(cuid())

  value Decimal @db.Decimal(10, 3)

  versionId String
  version   MeasurementVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  measurementDefinitionId String
  measurementDefinition   MeasurementDefinition @relation(fields: [measurementDefinitionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([versionId, measurementDefinitionId])
  @@index([versionId])
  @@index([measurementDefinitionId])
}

model Employee {
  id String @id @default(cuid())

  employeeCode String
  name         String
  email        String?
  phone        String?

  designation String?
  department  String?

  joiningDate DateTime?
  isActive    Boolean   @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  productionJobs ProductionJob[]
  tasks          Task[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([department])
  @@index([isActive])
}

model ProductionJob {
  id String @id @default(cuid())

  jobNumber String

  status ProductionStatus @default(PENDING)

  priority ProductionPriority @default(NORMAL)

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  notes String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  assignedEmployeeId String?
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, jobNumber])
  @@index([organizationId])
  @@index([orderId])
  @@index([assignedEmployeeId])
  @@index([status])
  @@index([dueDate])
}

enum ProductionStatus {
  PENDING
  CUTTING
  STITCHING
  FINISHING
  QC
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id String @id @default(cuid())

  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(NORMAL)

  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  productionJobId String?
  productionJob   ProductionJob? @relation(fields: [productionJobId], references: [id], onDelete: SetNull)

  assignedEmployeeId String?
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([productionJobId])
  @@index([assignedEmployeeId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
